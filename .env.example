# Supabase project URL — Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon (public) key — Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — Settings → API → service_role (NEVER ship to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL used to build RSVP form share links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — for sending RSVP invitation emails (resend.com)
# Leave blank to disable email sending
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com
